

import streamlit as st

st.title("Calculateur de moyenne")

st.write("Entre tes notes pour calculer ta moyenne universitaire.")

matieres = {

    "Comptabilité": 3,

    "Économie 1": 3,

    "Économie 2": 2,

    "Statistiques": 2,

    "Mathématiques": 2,

    "Informatique": 1,

    "Histoire": 1,

    "Droit": 1,

    "Science politique": 1,

    "Anglais": 1

}

total = 0

for matiere, coef in matieres.items():

    note = st.number_input(

        f"{matiere} (coef {coef})",

        min_value=0.0,

        max_value=20.0,

        step=0.25

    )

    total += note * coef

if st.button("Calculer ma moyenne"):

    moyenne = total / 18

    st.success(f"Ta moyenne est : {moyenne:.2f}/20")